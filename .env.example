# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 Git에 올라가지 않습니다)

# LLM 선택: ollama(로컬, 기본값) | claude
AI_PROVIDER=ollama

# Claude API (AI_PROVIDER=claude 일 때 필요)
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Oracle Database 23.2.0.0 (Free)
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
ORACLE_USERNAME=
ORACLE_PASSWORD=

# MCP 서버(/mcp) 접근 토큰. 비워두면 인증 없음
MCP_TOKEN=
